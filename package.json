{
  "name": "gohighpayment",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w packages/backend",
    "dev:admin": "npm run dev -w packages/admin-dashboard",
    "dev:merchant": "npm run dev -w packages/merchant-dashboard",
    "dev:checkout": "npm run dev -w packages/checkout",
    "build": "npm run build -w packages/backend && npm run build -w packages/admin-dashboard && npm run build -w packages/merchant-dashboard && npm run build -w packages/checkout && npm run build -w packages/sdk",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "prisma": "^5.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@esbuild/darwin-arm64": "^0.28.0",
    "@prisma/client": "^5.14.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
