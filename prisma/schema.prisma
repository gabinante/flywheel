// GoHighPayment Prisma Schema
// Agency, Merchant, ResidualEntry, ResidualPayout models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Agency ─────────────────────────────────────────────────────────

model Agency {
  id                 String           @id @default(cuid())
  name               String
  contactEmail       String           @unique
  contactPhone       String?
  passwordHash       String
  referralCode       String           @unique // e.g., "agency-abc123"
  referredByAgencyId String?
  referredByAgency   Agency?          @relation("AgencyReferrals", fields: [referredByAgencyId], references: [id])
  referredAgencies   Agency[]         @relation("AgencyReferrals")
  tier               AgencyTier       @default(TIER_1)
  tierOverride       Boolean          @default(false)
  status             AgencyStatus     @default(ACTIVE)
  payoutEmail        String?
  payoutBankLast4    String?
  taxIdOnFile        Boolean          @default(false)
  merchants          Merchant[]
  residualEntries    ResidualEntry[]
  residualPayouts    ResidualPayout[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

enum AgencyTier {
  TIER_1
  TIER_2
  TIER_3
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  CHURNED
}

// ─── Merchant ───────────────────────────────────────────────────────

model Merchant {
  id              String          @id @default(cuid())
  name            String
  email           String          @unique
  phone           String?
  nmiMerchantId   String?         @unique
  ghlLocationId   String?         @unique
  status          MerchantStatus  @default(ACTIVE)
  agencyId        String?
  agency          Agency?         @relation(fields: [agencyId], references: [id])
  attributedAt    DateTime?
  residualEntries ResidualEntry[]
  transactions    Transaction[]
  chargebacks     Chargeback[]

  // Chargeback risk monitoring (set by chargeback-monitor daily job)
  chargebackRiskLevel     String?   // null, WARNING, CRITICAL, HIGH
  chargebackRiskUpdatedAt DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ─── Transaction ────────────────────────────────────────────────────

model Transaction {
  id          String            @id @default(cuid())
  merchantId  String
  merchant    Merchant          @relation(fields: [merchantId], references: [id])
  amountCents Int
  status      TransactionStatus @default(PENDING)
  chargebacks Chargeback[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([merchantId, createdAt])
  @@index([status])
}

enum TransactionStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  SETTLED
  DECLINED
  VOIDED
  REFUNDED
}

// ─── Chargeback ─────────────────────────────────────────────────────

model Chargeback {
  id            String           @id @default(cuid())
  merchantId    String
  merchant      Merchant         @relation(fields: [merchantId], references: [id])
  transactionId String
  transaction   Transaction      @relation(fields: [transactionId], references: [id])
  amountCents   Int
  reason        String?
  reasonCode    String?
  status        ChargebackStatus @default(OPENED)
  dueDate       DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([merchantId])
  @@index([status])
}

enum ChargebackStatus {
  OPENED
  EVIDENCE_SUBMITTED
  UNDER_REVIEW
  WON
  LOST
  EXPIRED
}

// ─── ResidualEntry ──────────────────────────────────────────────────

model ResidualEntry {
  id                String         @id @default(cuid())
  agencyId          String
  agency            Agency         @relation(fields: [agencyId], references: [id])
  merchantId        String
  merchant          Merchant       @relation(fields: [merchantId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  merchantVolume    Int            // cents
  nmiResidualEarned Int            // cents
  agencyBps         Int
  agencyShare       Int            // cents
  twoTierAgencyId   String?
  twoTierShare      Int            @default(0)
  status            ResidualStatus @default(PENDING)
  approvedAt        DateTime?
  approvedBy        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([agencyId, merchantId, periodStart])
}

enum ResidualStatus {
  PENDING
  APPROVED
  PAID
  HELD
}

// ─── ResidualPayout ─────────────────────────────────────────────────

model ResidualPayout {
  id           String       @id @default(cuid())
  agencyId     String
  agency       Agency       @relation(fields: [agencyId], references: [id])
  periodStart  DateTime
  totalAmount  Int
  directShare  Int
  twoTierShare Int
  method       String
  reference    String?
  status       PayoutStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  FAILED
}

// ─── NotificationSchedule ──────────────────────────────────────────────

model NotificationSchedule {
  id           String             @id @default(cuid())
  merchantId   String?
  agencyId     String?
  templateId   String             // e.g., "merchant-welcome", "transaction-receipt"
  to           String             // recipient email address
  variables    Json               // template variables
  status       NotificationStatus @default(QUEUED)
  attempts     Int                @default(0)
  lastError    String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([merchantId])
  @@index([agencyId])
  @@index([status])
  @@index([templateId])
  @@index([createdAt])
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ─── GhlOAuthState ──────────────────────────────────────────────────────

model GhlOAuthState {
  id           String   @id @default(cuid())
  state        String   @unique // CSRF token
  referralCode String?  // agency referral code from ?ref= query param
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([state])
  @@index([expiresAt])
}

// ─── AuditLog ─────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  details     Json?
  performedBy String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
