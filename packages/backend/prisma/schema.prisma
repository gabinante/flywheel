// GoHighPayment Prisma Schema
// This is the database schema for the GoHighPayment platform.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums ----

enum BillingInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

// ---- Models ----

model Merchant {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  apiKey            String    @unique @map("api_key")
  apiKeyHash        String    @unique @map("api_key_hash")
  nmiSecurityKey    String?   @map("nmi_security_key")
  webhookSecret     String?   @map("webhook_secret")
  webhookUrl        String?   @map("webhook_url")
  isActive          Boolean   @default(true) @map("is_active")
  rateLimitOverride Json?     @map("rate_limit_override")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  checkoutSessions  CheckoutSession[]
  webhookEvents     WebhookEvent[]
  transactions      Transaction[]
  subscriptionPlans SubscriptionPlan[]
  subscriptions     Subscription[]

  @@map("merchants")
}

model CheckoutSession {
  id          String   @id @default(uuid())
  merchantId  String   @map("merchant_id")
  amount      Int
  currency    String   @default("USD")
  status      String   @default("pending")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("checkout_sessions")
}

model Transaction {
  id              String   @id @default(uuid())
  merchantId      String   @map("merchant_id")
  subscriptionId  String?  @map("subscription_id")
  nmiTransactionId String? @map("nmi_transaction_id")
  amount          Int
  currency        String   @default("USD")
  status          String   @default("pending")
  paymentMethod   String?  @map("payment_method")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("transactions")
}

model WebhookEvent {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  eventType  String   @map("event_type")
  payload    Json
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("webhook_events")
}

model SubscriptionPlan {
  id         String          @id @default(uuid())
  merchantId String          @map("merchant_id")
  name       String
  amount     Int             // amount in cents
  currency   String          @default("USD")
  interval   BillingInterval
  trialDays  Int             @default(0) @map("trial_days")
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  merchant      Merchant       @relation(fields: [merchantId], references: [id])
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  merchantId         String             @map("merchant_id")
  planId             String             @map("plan_id")
  customerId         String             @map("customer_id")
  nmiSubscriptionId  String?            @map("nmi_subscription_id")
  nmiCustomerVaultId String?            @map("nmi_customer_vault_id")
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  trialEnd           DateTime?          @map("trial_end")
  canceledAt         DateTime?          @map("canceled_at")
  cancelReason       String?            @map("cancel_reason")
  failedAttempts     Int                @default(0) @map("failed_attempts")
  pastDueAt          DateTime?          @map("past_due_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  merchant     Merchant         @relation(fields: [merchantId], references: [id])
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  transactions Transaction[]

  @@map("subscriptions")
}
