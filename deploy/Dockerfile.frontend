FROM node:20-alpine AS base
WORKDIR /app

ARG PACKAGE
ARG PORT=5173

# Install dependencies
COPY package.json package-lock.json* ./
COPY packages/${PACKAGE}/package.json ./packages/${PACKAGE}/
RUN npm install --workspace=packages/${PACKAGE}

# Copy source
COPY packages/${PACKAGE}/ ./packages/${PACKAGE}/
COPY tsconfig.json ./

# Build
RUN npm run build -w packages/${PACKAGE}

FROM nginx:alpine AS runner
ARG PACKAGE

COPY --from=base /app/packages/${PACKAGE}/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
