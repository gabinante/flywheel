# .env.schema — Declares all environment variables for the Warrant server.
# Used by varlock to validate and load configuration.
#
# Annotations:
#   @sensitive  — Value is a secret; varlock will never log or print it.
#   @required   — Server will not start without this variable set.
#   @optional   — Variable has a sensible default or is not always needed.
#
# Format: KEY=default_value  # @annotation description

# --- Server ---
PORT=8080                                   # @optional Server listen port

# --- Database ---
DATABASE_URL=                               # @required @sensitive Postgres connection string

# --- Redis ---
REDIS_URL=                                  # @required @sensitive Redis connection string

# --- Authentication (GitHub OAuth2) ---
GITHUB_CLIENT_ID=                           # @optional GitHub OAuth app client ID
GITHUB_CLIENT_SECRET=                       # @optional @sensitive GitHub OAuth app client secret
JWT_SECRET=                                 # @optional @sensitive Signing key for JWTs

# --- URLs ---
BASE_URL=                                   # @optional Public base URL (defaults to http://localhost:PORT)
AUTH_SUCCESS_REDIRECT_URL=                  # @optional Post-login redirect URL

# --- Web UI ---
WEB_DIST=web/dist                           # @optional Path to Vite build output
WEB_DEV_PROXY_URL=                         # @optional Reverse proxy frontend requests to a running Vite dev server (e.g. http://127.0.0.1:5173)

# --- Queue ---
LEASE_TTL_MINUTES=10                        # @optional Lease TTL for claimed tickets (minutes)

# --- Acceptance tests ---
RUN_ACCEPTANCE_TEST_ON_SUBMIT=false         # @optional Run acceptance tests on ticket submit

# --- Dispatch (agent worker pool) ---
DISPATCH_ENABLED=false                      # @optional Enable dispatch worker pool
DISPATCH_MAX_WORKERS=4                      # @optional Max concurrent workers
DISPATCH_AGENT_RUNNER=cli                   # @optional Worker execution backend (cli, docker, openai-responses)
DISPATCH_CLAUDE_PATH=claude                 # @optional Path to claude CLI binary
DISPATCH_AGENT_DRIVER=claude                # @optional Agent driver name (claude, codex, generic, or custom)
DISPATCH_AGENT_CMD=                         # @optional Override the selected driver's CLI binary path
DISPATCH_AGENT_API_KEY=                     # @optional @sensitive Generic API credential passed to dockerized agent drivers
OPENAI_API_KEY=                             # @optional @sensitive Fallback credential for Codex and openai-responses dispatch workers
DISPATCH_AGENT_MODEL=                       # @optional Model name for API-native runners (default gpt-5.2-codex for openai-responses)
DISPATCH_AGENT_REASONING_EFFORT=            # @optional Reasoning effort for API-native runners
DISPATCH_AGENT_API_BASE_URL=https://api.openai.com/v1 # @optional Base URL for API-native runners
DISPATCH_WORKTREE_DIR=/tmp/warrant-worktrees # @optional Base directory for git worktrees
DISPATCH_API_KEY=                           # @optional @sensitive Warrant API key for worker auth
DISPATCH_PROJECT_ID=                        # @optional @deprecated Use per-project dispatch_enabled toggle in the UI instead. Legacy: only dispatch tickets for this project.
AUTO_APPROVE_ON_ACCEPTANCE_PASS=false       # @optional Auto-approve tickets that pass acceptance

# --- Command Center Orchestrator ---
ORCHESTRATOR_ENABLED=true                   # @optional Enable the command-center orchestrator chat service
ORCHESTRATOR_AGENT_RUNNER=                  # @optional Orchestrator execution backend (defaults to DISPATCH_AGENT_RUNNER)
ORCHESTRATOR_AGENT_DRIVER=                  # @optional Orchestrator driver (defaults to DISPATCH_AGENT_DRIVER)
ORCHESTRATOR_AGENT_CMD=                     # @optional Override the orchestrator agent CLI binary path
ORCHESTRATOR_AGENT_API_KEY=                 # @optional @sensitive Explicit provider credential for the orchestrator
ORCHESTRATOR_AGENT_MODEL=                   # @optional Orchestrator model name (defaults to DISPATCH_AGENT_MODEL)
ORCHESTRATOR_AGENT_REASONING_EFFORT=        # @optional Orchestrator reasoning effort
ORCHESTRATOR_AGENT_API_BASE_URL=            # @optional Base URL for the orchestrator API runner
ORCHESTRATOR_HISTORY_LIMIT=200              # @optional Max messages retained in the persisted orchestrator thread

# --- Dispatch: Docker isolation ---
DISPATCH_DOCKER_ENABLED=false               # @optional Enable Docker-based worker isolation
DISPATCH_DOCKER_IMAGE=warrant-worker        # @optional Worker container image name
DISPATCH_DOCKER_MEMORY=4g                   # @optional Memory limit per worker container
DISPATCH_DOCKER_CPUS=2                      # @optional CPU limit per worker container
DISPATCH_DOCKER_FIREWALL=true               # @optional Enable default-deny firewall in workers

# --- Dispatch: Legacy Claude credential fallback ---
ANTHROPIC_API_KEY=                          # @optional @sensitive Deprecated fallback for Claude dispatch workers; prefer DISPATCH_AGENT_API_KEY

# --- State Index (Layer 10) ---
STEAMPIPE_CONNECTION_STRING=                # @optional @sensitive Steampipe Postgres connection (default: postgresql://steampipe@localhost:9193/steampipe)

# --- State Index (Layer 10) ---
STEAMPIPE_CONNECTION_STRING=                # @optional @sensitive Steampipe Postgres connection (default: postgresql://steampipe@localhost:9193/steampipe)

# --- Findings (Layer 4) ---
WEAVIATE_URL=                               # @optional Weaviate server URL (e.g. http://localhost:8088). When set, findings use Weaviate; otherwise falls back to in-memory store.
WEAVIATE_API_KEY=                           # @optional @sensitive Weaviate API key (for Weaviate Cloud)
WEAVIATE_VECTORIZER=text2vec-openai         # @optional Weaviate vectorizer module (text2vec-openai, text2vec-transformers, none)

# --- Notifications ---
NOTIFICATION_ENABLED=true                   # @optional Enable notification push layer
NOTIFICATION_SLACK_WEBHOOK_URL=             # @optional @sensitive Default Slack incoming webhook URL for notifications

# --- Field-Level Encryption (GoHighPayment) ---
ENCRYPTION_KEY=                             # @required @sensitive AES-256-GCM key for encrypting Merchant credentials and Application PII. Must be 32 bytes hex-encoded (64 chars). Generate: openssl rand -hex 32
ENCRYPTION_KEY_PREV=                        # @optional @sensitive Previous encryption key for key rotation. Set during rotation, remove after completion.
