# .env.schema — Declares all environment variables for the Flywheel server.
# Used by varlock to validate and load configuration.
#
# Annotations:
#   @sensitive  — Value is a secret; varlock will never log or print it.
#   @required   — Server will not start without this variable set.
#   @optional   — Variable has a sensible default or is not always needed.
#
# Format: KEY=default_value  # @annotation description

# --- Server ---
PORT=8090                                   # @optional Server listen port (non-default to avoid other local dev stacks)
BASE_URL=                                   # @optional Public base URL (defaults to http://localhost:PORT)
WEB_DIST=web/dist                           # @optional Path to Vite build output
WEB_DEV_PROXY_URL=                          # @optional Reverse proxy frontend requests to a running Vite dev server (e.g. http://127.0.0.1:5173)

# --- Database ---
DATABASE_URL=                               # @required @sensitive Postgres connection string

# --- Redis ---
REDIS_URL=                                  # @required @sensitive Redis connection string

# --- Auth (single local operator) ---
JWT_SECRET=                                 # @optional @sensitive Signing key for operator JWTs; generated per process when empty
AUTH_SUCCESS_REDIRECT_URL=                  # @optional Post-login redirect URL

# --- Queue ---
LEASE_TTL_MINUTES=10                        # @optional Lease TTL for claimed tickets (minutes)

# --- Acceptance tests ---
RUN_ACCEPTANCE_TEST_ON_SUBMIT=false         # @optional Run acceptance tests on ticket submit
AUTO_APPROVE_ON_ACCEPTANCE_PASS=false       # @optional Auto-approve tickets that pass acceptance

# --- Dispatch (agent worker pool) ---
DISPATCH_ENABLED=false                      # @optional Enable dispatch worker pool
DISPATCH_MAX_WORKERS=4                      # @optional Max concurrent workers
DISPATCH_AGENT_RUNNER=cli                   # @optional Worker execution backend (cli)
DISPATCH_AGENT_DRIVER=claude                # @optional Agent driver (claude, codex, generic)
DISPATCH_CLAUDE_PATH=claude                 # @optional Path to claude CLI binary
DISPATCH_AGENT_CMD=                         # @optional Override the selected driver's CLI binary path
DISPATCH_AGENT_MODEL=                       # @optional Model name passed to the harness when supported
DISPATCH_AGENT_REASONING_EFFORT=            # @optional Reasoning effort passed to the harness when supported
DISPATCH_AGENT_API_KEY=                     # @optional @sensitive Explicit provider credential for dispatch workers
DISPATCH_WORKTREE_DIR=                      # @optional Code root; worktrees go under <root>/<repo>-worktrees/<slug> (default ~/git)
DISPATCH_API_KEY=                           # @optional @sensitive Flywheel API key for worker MCP auth
DISPATCH_PROJECT_ID=                        # @optional @deprecated Use per-project dispatch_enabled toggle in the UI instead
DISPATCH_RECONCILE_INTERVAL=60s             # @optional Periodic reconciliation interval

# --- Command Center Orchestrator ---
ORCHESTRATOR_ENABLED=true                   # @optional Enable the command-center orchestrator chat service
ORCHESTRATOR_AGENT_RUNNER=                  # @optional Orchestrator execution backend (defaults to DISPATCH_AGENT_RUNNER)
ORCHESTRATOR_AGENT_DRIVER=                  # @optional Orchestrator driver (defaults to DISPATCH_AGENT_DRIVER)
ORCHESTRATOR_AGENT_CMD=                     # @optional Override the orchestrator agent CLI binary path
ORCHESTRATOR_AGENT_API_KEY=                 # @optional @sensitive Explicit provider credential for the orchestrator
ORCHESTRATOR_AGENT_MODEL=                   # @optional Orchestrator model name (defaults to DISPATCH_AGENT_MODEL)
ORCHESTRATOR_AGENT_REASONING_EFFORT=        # @optional Orchestrator reasoning effort
ORCHESTRATOR_HISTORY_LIMIT=200              # @optional Max messages retained in the persisted orchestrator thread

# --- Code review (PR-keyed; posts via the authenticated gh CLI) ---
REVIEW_ENABLED=true                         # @optional Run the review queue and GitHub watchers
REVIEW_HARNESS=codex                        # @optional Harness for reviews: codex or claude
REVIEW_MODEL=                               # @optional Model override for the review harness
REVIEW_REASONING_EFFORT=                    # @optional Reasoning effort for the review harness
REVIEW_PUBLISH=false                        # @optional Post reviews to GitHub; false = dry run (findings recorded, nothing posted)
REVIEW_POLL_INTERVAL=2m                     # @optional How often to poll review-requested PRs, watched PRs, and landed reviews
REVIEW_MAX_CONCURRENT=2                     # @optional Concurrent reviews
REVIEW_REPO_ROOT=                           # @optional Where clones and review worktrees live (default ~/git)
REVIEW_WATCH_REQUESTED=true                 # @optional Queue PRs where your review is requested
REVIEW_WATCH_AUTHORED=true                  # @optional Watch your own PRs for landed reviews
REVIEW_TIMEOUT=30m                          # @optional Per-review time limit
REVIEW_SKIP_DRAFTS=true                     # @optional Wait for draft PRs to be marked ready

# --- Address review feedback on your own PRs ---
FEEDBACK_HARNESS=claude                     # @optional Harness that resolves landed review comments: claude or codex
FEEDBACK_MODEL=                             # @optional Model override
FEEDBACK_REASONING_EFFORT=                  # @optional Reasoning effort override
FEEDBACK_AUTO_ADDRESS=false                 # @optional Dispatch automatically when a review with comments or CHANGES_REQUESTED lands
FEEDBACK_TIMEOUT=45m                        # @optional Per-run time limit

# --- Reports (Linear project updates + weekly roundup) ---
REPORT_PROJECT_UPDATES_ENABLED=false        # @optional Post a delta status update to each linked Linear project on a cadence
REPORT_PROJECT_UPDATE_INTERVAL=48h          # @optional Cadence for automatic project updates
REPORT_WEEKLY_ENABLED=false                 # @optional Post the weekly roundup automatically
REPORT_WEEKLY_DAY=Friday                    # @optional Weekday for the automatic roundup
REPORT_WEEKLY_HOUR=16                       # @optional Local hour for the automatic roundup
REPORT_ROUNDUP_DOCUMENT_ID=                 # @optional Linear document that receives each week's roundup (prepended)
REPORT_ROUNDUP_PROJECT_ID=                  # @optional Flywheel project whose Linear project receives the weekly accomplishment update
REPORT_HEALTH_DEFAULT=onTrack               # @optional Default health for project updates

# --- Linear (ticket store) ---
LINEAR_API_KEY=                             # @optional @sensitive Personal API key; when set, Linear projects you lead become Flywheel projects and their issues become tickets
LINEAR_SYNC_ENABLED=                        # @optional Defaults to true when LINEAR_API_KEY is set
LINEAR_PROJECT_IDS=                         # @optional Comma-separated Linear project IDs to sync instead of projects you lead
LINEAR_SYNC_INTERVAL=60s                    # @optional Poll interval for inbound issue sync
LINEAR_DEFAULT_TEAM_KEY=                    # @optional Team key used when filing issues into a multi-team project

# --- Session tracking (Claude Code + Codex local stores) ---
SESSIONS_ENABLED=true                       # @optional Ingest Claude Code and Codex sessions into Flywheel
SESSIONS_CLAUDE_DIR=                        # @optional Claude Code transcripts dir (default ~/.claude/projects)
SESSIONS_CODEX_DIR=                         # @optional CODEX_HOME (default ~/.codex)
SESSIONS_POLL_INTERVAL=10s                  # @optional How often to tail the local stores

# --- Legacy Claude credential fallback ---
ANTHROPIC_API_KEY=                          # @optional @sensitive Fallback credential for the claude driver; prefer DISPATCH_AGENT_API_KEY
