# Server
PORT=8080

# Database (use postgres:5432 when running inside Docker Compose)
DATABASE_URL=postgres://flywheel:flywheel@postgres:5432/flywheel?sslmode=disable

# Redis (use redis:6379 when running inside Docker Compose)
REDIS_URL=redis://redis:6379/0

# GitHub OAuth2 (required for sign-in and MCP URL auth). Do not commit real values.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=

# Optional: public base URL (defaults to http://localhost:PORT)
# BASE_URL=http://localhost:8080

# Optional: Vite build output directory for the web UI (default web/dist). Leave default after `cd web && npm run build`.
# WEB_DIST=web/dist
# Optional: proxy frontend requests to Vite in local dev so http://localhost:8080 gets HMR too.
# WEB_DEV_PROXY_URL=http://127.0.0.1:5173

# Optional: redirect here after login; callback appends #token=<jwt> (fragment)
# AUTH_SUCCESS_REDIRECT_URL=

# Optional: queue lease TTL in minutes (default 10)
# LEASE_TTL_MINUTES=10

# Optional: run objective.acceptance_test (shell command) on submit_ticket; if it fails, submit is rejected (default false)
# RUN_ACCEPTANCE_TEST_ON_SUBMIT=true

# Optional: enable dispatch workers
# DISPATCH_ENABLED=true
# DISPATCH_MAX_WORKERS=4
# DISPATCH_AGENT_RUNNER=cli
# DISPATCH_AGENT_DRIVER=claude
# DISPATCH_AGENT_CMD=
# DISPATCH_AGENT_API_KEY=
# OPENAI_API_KEY=
# DISPATCH_AGENT_MODEL=
# DISPATCH_AGENT_REASONING_EFFORT=
# DISPATCH_AGENT_API_BASE_URL=https://api.openai.com/v1
# DISPATCH_CLAUDE_PATH=claude
# DISPATCH_WORKTREE_DIR=/tmp/warrant-worktrees
# DISPATCH_API_KEY=
# DISPATCH_PROJECT_ID=
# AUTO_APPROVE_ON_ACCEPTANCE_PASS=false

# Optional: separate command-center orchestrator profile
# ORCHESTRATOR_ENABLED=true
# ORCHESTRATOR_AGENT_RUNNER=openai-responses
# ORCHESTRATOR_AGENT_DRIVER=codex
# ORCHESTRATOR_AGENT_CMD=
# ORCHESTRATOR_AGENT_API_KEY=
# ORCHESTRATOR_AGENT_MODEL=gpt-5.2-codex
# ORCHESTRATOR_AGENT_REASONING_EFFORT=xhigh
# ORCHESTRATOR_AGENT_API_BASE_URL=https://api.openai.com/v1
# ORCHESTRATOR_HISTORY_LIMIT=200

# Optional: Docker-isolated workers
# DISPATCH_DOCKER_ENABLED=false
# DISPATCH_DOCKER_IMAGE=flywheel-worker
# DISPATCH_DOCKER_MEMORY=4g
# DISPATCH_DOCKER_CPUS=2
# DISPATCH_DOCKER_FIREWALL=true

# Legacy Claude-only fallback for dispatch. Prefer DISPATCH_AGENT_API_KEY.
# ANTHROPIC_API_KEY=

# ─── Sentry Error Tracking ──────────────────────────────────────────
# Backend Sentry DSN (Node.js / Fastify)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend Sentry DSNs (React / Vite)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=
