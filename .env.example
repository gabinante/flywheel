# Server (non-default port so it never collides with other local dev stacks)
PORT=8090

# Database (Docker Compose maps Postgres to localhost:5439)
DATABASE_URL=postgres://flywheel:flywheel@localhost:5439/flywheel?sslmode=disable

# Redis (Docker Compose maps Redis to localhost:6389)
REDIS_URL=redis://localhost:6389/0

# Operator sign-in. GET /auth/login issues a JWT for the single local operator.
# Set a stable secret so UI sessions survive server restarts.
JWT_SECRET=

# Optional: public base URL (defaults to http://localhost:PORT)
# BASE_URL=http://localhost:8090

# Optional: Vite build output directory for the web UI (default web/dist).
# WEB_DIST=web/dist
# Optional: proxy frontend requests to Vite in local dev so http://localhost:8090 gets HMR too.
# WEB_DEV_PROXY_URL=http://127.0.0.1:5173

# Optional: queue lease TTL in minutes (default 10)
# LEASE_TTL_MINUTES=10

# Optional: run objective.acceptance_test on submit_ticket (default false)
# RUN_ACCEPTANCE_TEST_ON_SUBMIT=true
# AUTO_APPROVE_ON_ACCEPTANCE_PASS=false

# Optional: dispatch workers (local CLI harnesses)
# DISPATCH_ENABLED=true
# DISPATCH_MAX_WORKERS=4
# DISPATCH_AGENT_RUNNER=cli
# DISPATCH_AGENT_DRIVER=claude          # claude | codex | generic
# DISPATCH_AGENT_CMD=
# DISPATCH_AGENT_MODEL=
# DISPATCH_AGENT_REASONING_EFFORT=
# DISPATCH_CLAUDE_PATH=claude
# DISPATCH_WORKTREE_DIR=~/git      # worktrees under <root>/<repo>-worktrees/<slug>
# DISPATCH_API_KEY=

# Code review. Reviews are dry runs until REVIEW_PUBLISH=true.
# REVIEW_ENABLED=true
# REVIEW_HARNESS=codex           # codex | claude
# REVIEW_PUBLISH=false
# REVIEW_POLL_INTERVAL=2m
# REVIEW_REPO_ROOT=~/git

# Address landed review feedback on your PRs (manual trigger unless FEEDBACK_AUTO_ADDRESS=true).
# FEEDBACK_HARNESS=claude
# FEEDBACK_AUTO_ADDRESS=false

# Linear as the ticket store. Create a personal API key at linear.app/settings/api.
# LINEAR_API_KEY=lin_api_...
# LINEAR_PROJECT_IDS=            # optional; default = projects you lead
# LINEAR_SYNC_INTERVAL=60s
# LINEAR_DEFAULT_TEAM_KEY=RLETD  # optional; team for issues Flywheel files into multi-team projects

# Optional: session tracking (reads the harnesses' local stores read-only)
# SESSIONS_ENABLED=true
# SESSIONS_CLAUDE_DIR=~/.claude/projects
# SESSIONS_CODEX_DIR=~/.codex
# SESSIONS_POLL_INTERVAL=10s

# Optional: separate command-center orchestrator profile
# ORCHESTRATOR_ENABLED=true
# ORCHESTRATOR_AGENT_DRIVER=claude
# ORCHESTRATOR_AGENT_CMD=
# ORCHESTRATOR_AGENT_MODEL=
# ORCHESTRATOR_AGENT_REASONING_EFFORT=
# ORCHESTRATOR_HISTORY_LIMIT=200
