# Database
DATABASE_URL=postgresql://gohighpayment:gohighpayment@localhost:5433/gohighpayment
DIRECT_URL=postgresql://gohighpayment:gohighpayment@localhost:5433/gohighpayment

# Redis
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
MERCHANT_URL=http://localhost:5175
CHECKOUT_URL=http://localhost:5176

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# NMI (platform-level settings — merchants bring their own NMI API keys)
NMI_WEBHOOK_SECRET=
NMI_MOCK_MODE=true
NMI_BOARDING_API_URL=https://secure.nmi.com/api/boarding/
NMI_PARTNER_ID=your-nmi-partner-id
NMI_PARTNER_KEY=your-nmi-partner-key

# Digital Wallets (via NMI Collect.js)
GOOGLE_PAY_MERCHANT_ID=
APPLE_PAY_MERCHANT_ID=

# Seamlesschex (platform-level settings — merchants bring their own API keys)
SEAMLESSCHEX_WEBHOOK_SECRET=
SEAMLESSCHEX_SANDBOX=true

# GHL (GoHighLevel)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_REDIRECT_URI=http://localhost:3000/api/v1/ghl/callback
GHL_APP_ID=
GHL_SSO_KEY=

# Field-level encryption for sensitive data (Merchant credentials, Application PII).
# Must be exactly 32 bytes: hex-encoded (64 chars) or base64-encoded (44 chars).
# Generate with: openssl rand -hex 32
# Required for backend startup — will fail fast if missing or wrong length.
ENCRYPTION_KEY=
# Previous key for rotation. Set when rotating keys, remove after rotation is complete.
# ENCRYPTION_KEY_PREV=
